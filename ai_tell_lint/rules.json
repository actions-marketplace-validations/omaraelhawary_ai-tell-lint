    "Filler connector": [
      "\\bmoreover\\b",
      "\\bfurthermore\\b",
      "(?<![a-z])additionally,",
      "\\bnotably,",
      "\\bimportantly,",
      "it'?s worth noting",
      "it is worth noting",
      "it'?s important to note",
      "it is important to note",
      "\\bthat said,"
